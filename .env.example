# --- Model backend ---
# "mock"   = fully offline, deterministic (tests, CI, demos without a GCP project)
# "gemini" = Gemini on Vertex AI
FIXPILOT_LLM_BACKEND=mock

# Required when FIXPILOT_LLM_BACKEND=gemini
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Use a current multimodal Gemini model ID from Vertex AI Model Garden
FIXPILOT_MODEL=gemini-2.5-flash

# --- Retrieval ---
# "local"      = keyword retriever over kb/docs (offline)
# "vertex_rag" = Vertex AI RAG Engine corpus
FIXPILOT_RETRIEVER=local
FIXPILOT_RAG_CORPUS=projects/PROJECT/locations/LOCATION/ragCorpora/CORPUS_ID

# --- Ticketing ---
# "mock" or "servicenow"
FIXPILOT_TICKETING=mock
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# --- Guardrails ---
# Below this vision confidence the agent asks for a clearer photo instead of guessing
FIXPILOT_MIN_VISION_CONFIDENCE=0.6
